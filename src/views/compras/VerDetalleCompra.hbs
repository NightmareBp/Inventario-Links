<div class="container-xl py-4">

    <div class="card">

        <div
            class="
                card-header
                d-flex
                justify-content-between
                align-items-center
                flex-wrap
                gap-2
            "
        >

            <div>

                <h4 class="mb-1">
                    Compra #{{compra.id_compra}}
                </h4>

                <small class="text-muted">
                    {{compra.fecha_mostrar}}
                    ·
                    {{compra.hora_mostrar}}
                </small>

            </div>


            <a
                href="/compras"
                class="btn btn-sm btn-outline-secondary"
            >
                Volver
            </a>

        </div>


        <div class="p-3 border-bottom"><strong>Proveedor:</strong> {{#if compra.contacto_nombre}}{{compra.contacto_nombre}} {{compra.contacto_documento}}{{else}}Sin registrar{{/if}}<br>
<strong>Registrado por:</strong> {{#if compra.usuario_nombre}}{{compra.usuario_nombre}}{{else}}No registrado (operación antigua){{/if}}</div>
<div class="card-body p-0">

            <div class="table-responsive">

                <table
                    class="
                        table
                        table-hover
                        align-middle
                        mb-0
                    "
                >

                    <thead class="table-light">

                        <tr>

                            <th>
                                Producto
                            </th>

                            <th>
                                Unidad
                            </th>

                            <th class="text-end">
                                Precio
                            </th>

                            <th class="text-end">
                                Cantidad
                            </th>

                            <th class="text-end">
                                Subtotal
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        {{#each detalles}}

                            <tr>

                                <td>
                                    {{nombre_producto}}
                                </td>

                                <td>
                                    {{nombre_unidad}}

                                    <small class="text-muted">
                                        ({{cantidad_unidad}})
                                    </small>
                                </td>

                                <td class="text-end">
                                    S/. {{precio_unitario}}
                                </td>

                                <td class="text-end">
                                    {{cantidad_producto}}
                                </td>

                                <td class="text-end fw-semibold">
                                    S/. {{precio_parcial}}
                                </td>

                            </tr>

                        {{/each}}


                        <tr class="table-success">

                            <th colspan="4">
                                TOTAL
                            </th>

                            <th class="text-end">
                                S/. {{compra.monto_total}}
                            </th>

                        </tr>

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>