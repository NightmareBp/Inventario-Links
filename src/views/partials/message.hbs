<div class="flash-messages">

    {{#if success}}
    <div class="alert alert-success alert-dismissible fade show flash-alert" role="alert">
        
        <div class="flash-alert-content">
            <i class="fas fa-check-circle flash-alert-icon"></i>

            <span>
                {{success}}
            </span>
        </div>

        <button
            type="button"
            class="btn-close"
            data-bs-dismiss="alert"
            aria-label="Cerrar"
        ></button>

    </div>
    {{/if}}


    {{#if message}}
    <div class="alert alert-danger alert-dismissible fade show flash-alert" role="alert">

        <div class="flash-alert-content">
            <i class="fas fa-exclamation-circle flash-alert-icon"></i>

            <span>
                {{message}}
            </span>
        </div>

        <button
            type="button"
            class="btn-close"
            data-bs-dismiss="alert"
            aria-label="Cerrar"
        ></button>

    </div>
    {{/if}}


    {{#if noti}}
    <div class="alert alert-primary alert-dismissible fade show flash-alert" role="alert">

        <div class="flash-alert-content">
            <i class="fas fa-info-circle flash-alert-icon"></i>

            <span>
                {{noti}}
            </span>
        </div>

        <button
            type="button"
            class="btn-close"
            data-bs-dismiss="alert"
            aria-label="Cerrar"
        ></button>

    </div>
    {{/if}}

</div>


<script>

    document.addEventListener('DOMContentLoaded', () => {

        const alerts =
            document.querySelectorAll('.flash-alert');


        alerts.forEach((alert) => {

            /*
             * Cerrar automáticamente después
             * de 5 segundos.
             */
            setTimeout(() => {

                /*
                 * Verificamos que la alerta
                 * todavía exista.
                 */
                if (!document.body.contains(alert)) {
                    return;
                }


                /*
                 * Usamos Bootstrap para mantener
                 * la animación de cierre.
                 */
                if (
                    typeof bootstrap !== 'undefined' &&
                    bootstrap.Alert
                ) {

                    const bootstrapAlert =
                        bootstrap.Alert.getOrCreateInstance(alert);

                    bootstrapAlert.close();

                } else {

                    /*
                     * Respaldo por si Bootstrap JS
                     * todavía no estuviera disponible.
                     */
                    alert.remove();

                }

            }, 5000);

        });

    });

</script>