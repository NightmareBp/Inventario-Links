</style>



<script>

    /* =====================================================
       CONTADOR DE NOTIFICACIONES
    ====================================================== */

    async function loadNotificationCount() {


        /*
         * Si no existe notificationCount,
         * significa que no hay sesión iniciada
         * o que el navbar mostrado no contiene
         * notificaciones.
         */

        const notificationCount =
            document.getElementById(
                'notificationCount'
            );


        if (!notificationCount) {

            return;

        }


        try {


            const response =
                await fetch(
                    '/notificaciones/notificationCount',
                    {

                        method:
                            'GET',

                        headers: {

                            'Accept':
                                'application/json'

                        }

                    }
                );


            if (!response.ok) {


                console.error(
                    'Error al obtener notificaciones:',
                    response.status
                );


                return;

            }


            const data =
                await response.json();


            const count =
                Number(
                    data.cuenta
                ) || 0;



            if (count > 0) {


                /*
                 * Si algún día hubiese más de 99,
                 * evitamos un círculo enorme
                 * dentro de la barra.
                 */

                notificationCount.textContent =
                    count > 99
                        ? '99+'
                        : String(count);


                notificationCount.style.display =
                    '';


                notificationCount.setAttribute(
                    'aria-label',
                    `${count} notificaciones nuevas`
                );


            }

            else {


                notificationCount.textContent =
                    '';


                notificationCount.style.display =
                    'none';


                notificationCount.removeAttribute(
                    'aria-label'
                );


            }


        }

        catch (error) {


            console.error(
                'Error al cargar el número de notificaciones:',
                error
            );


        }

    }



    /* =====================================================
       CARGAR DESPUÉS DE INICIAR LA PÁGINA
    ====================================================== */

    document.addEventListener(
        'DOMContentLoaded',
        loadNotificationCount
    );

</script>