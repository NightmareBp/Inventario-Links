<div class="container-xl py-4">

    <div
        class="
            d-flex
            justify-content-between
            align-items-center
            flex-wrap
            gap-2
            mb-3
        "
    >

        <h2 class="m-0">
            Ventas
        </h2>


        <a
            class="btn btn-success"
            href="/ventas/add"
        >
            <i class="fas fa-plus me-1"></i>
            Nueva Venta
        </a>

    </div>


    <div class="card mb-3">

        <div class="card-body">

            <form
                action="/ventas"
                method="GET"
                class="row g-2 align-items-end"
            >

                <div class="col-md-3">

                    <label class="form-label">
                        Desde
                    </label>

                    <input
                        type="date"
                        name="q"
                        value="{{q}}"
                        class="form-control"
                    >

                </div>


                <div class="col-md-3">

                    <label class="form-label">
                        Hasta
                    </label>

                    <input
                        type="date"
                        name="q1"
                        value="{{q1}}"
                        class="form-control"
                    >

                </div>


                <div class="col-md-3">

                    <label class="form-label">
                        Orden
                    </label>

                    <select
                        name="orden"
                        class="form-select"
                    >

                        <option
                            value="desc"
                            {{#ifvalue orden value="desc"}}selected{{/ifvalue}}
                        >
                            Más recientes primero
                        </option>

                        <option
                            value="asc"
                            {{#ifvalue orden value="asc"}}selected{{/ifvalue}}
                        >
                            Más antiguas primero
                        </option>

                    </select>

                </div>


                <div class="col-md-3">

                    <div class="d-flex gap-2">

                        <button
                            type="submit"
                            class="btn btn-primary flex-grow-1"
                        >
                            Aplicar
                        </button>

                        <a
                            href="/ventas"
                            class="btn btn-outline-secondary"
                        >
                            Limpiar
                        </a>

                    </div>

                </div>

            </form>

        </div>

    </div>


    {{#if montototall}}

        <div
            class="
                alert alert-light
                border
                d-flex
                justify-content-between
                align-items-center
            "
        >

            <span>
                Total del período
            </span>

            <strong>
                S/. {{montototall}}
            </strong>

        </div>

    {{/if}}


    {{#if ventas}}

        <div class="table-responsive">

            <table
                class="
                    table
                    table-hover
                    align-middle
                "
            >

                <thead class="table-primary">

                    <tr>

                        <th>
                            N°
                        </th>

                        <th>
                            Fecha
                        </th>

                        <th>
                            Hora
                        </th>

                        <th class="text-end">
                            Total
                        </th>

                        <th class="text-end">
                            Acción
                        </th>

                    </tr>

                </thead>


                <tbody>

                    {{#each ventas}}

                        <tr>

                            <td>
                                #{{id_venta}}
                            </td>

                            <td>
                                {{fecha_mostrar}}
                            </td>

                            <td>
                                {{hora_mostrar}}
                            </td>

                            <td class="text-end fw-semibold">
                                S/. {{monto_total}}
                            </td>

                            <td class="text-end">

                                <a
                                    class="btn btn-sm btn-outline-secondary"
                                    href="/ventas/detalle/{{id_venta}}"
                                >
                                    Ver detalle
                                </a>

                            </td>

                        </tr>

                    {{/each}}

                </tbody>

            </table>

        </div>

    {{else}}

        <div class="text-center py-5 text-muted">

            <h4>
                No hay ventas para mostrar
            </h4>

        </div>

    {{/if}}

</div>